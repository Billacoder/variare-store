generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id         String      @id @default(cuid())
  name       String
  phone      String
  email      String?
  address    String
  apartment  String?
  city       String
  state      String
  pincode    String

  total      Float
  status     String      @default("Pending")

  createdAt  DateTime    @default(now())

  items       OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  productName String

  price       Float
  quantity    Int
  size        String?

  createdAt   DateTime @default(now())
}

model CustomOrder {
  id            String   @id @default(cuid())

  // Customer
  name          String
  email         String
  phone         String

  // Order Details
  product       String
  measurements  Json
  notes         String?

  timeline      String

  // Uploaded image URLs
  imageUrls     String[]

  agreed        Boolean

  // Workflow
  status        String   @default("Pending")

  createdAt     DateTime @default(now())
}